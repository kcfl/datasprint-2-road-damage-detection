# ==============================================================================
# Cloud API Provider Configurations for DeepSeek Harness (DSH) & Agents
# ==============================================================================

# ------------------------------------------------------------------------------
# Option 1: Official DeepSeek Direct API
# Signup: https://platform.deepseek.com/api_keys
# Model: deepseek-reasoner (R1) or deepseek-chat (V3)
# ------------------------------------------------------------------------------
DEEPSEEK_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com

# ------------------------------------------------------------------------------
# Option 2: OpenRouter (Official Free Tier Available)
# Signup: https://openrouter.ai/keys
# Free Models: deepseek/deepseek-r1:free, deepseek/deepseek-chat:free, openrouter/free
# (To use OpenRouter, uncomment the lines below and set OPENAI_BASE_URL)
# ------------------------------------------------------------------------------
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# ------------------------------------------------------------------------------
# Option 3: NVIDIA NIM (Free Prototyping Developer Access)
# Signup: https://build.nvidia.com/ (no credit card required)
# Models: deepseek-ai/deepseek-r1, deepseek-ai/deepseek-v3
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=nvapi-...
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
